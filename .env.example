# Optional: S-User fuer das Login-CLI (Prefill interaktiv bzw. Anmeldename nicht-interaktiv).
#SAP_USERNAME=s0001234567

# Optional: aktiviert das NICHT-INTERAKTIVE Login (S-User ohne MFA) im Login-CLI.
# Nur das Login-CLI liest diesen Wert — der MCP-Server liest NIE ein Passwort.
# Ausschliesslich ueber einen Secret-Store setzen, nie im Klartext committen.
#SAP_PASSWORD=

# Optional: Formular-Selektoren fuer das nicht-interaktive Login anpassen,
# falls der Identity-Provider sein Layout aendert.
#SAP_LOGIN_USER_SELECTOR=input[name='j_username'], #j_username, input[type='email']
#SAP_LOGIN_PASS_SELECTOR=input[name='j_password'], #j_password, input[type='password']
#SAP_LOGIN_SUBMIT_SELECTOR=button[type='submit'], input[type='submit']

# Optional: URLs anpassen, falls SAP das Portal umbaut
#SAP_SEARCH_URL=https://me.sap.com/search?q={query}&tab=notes
#SAP_COVEO_ORG=sapamericaproductiontyfzmfz0
#SAP_COVEO_TOKEN_URL=https://me.sap.com/backend/raw/coveo/CoveoToken
#SAP_COVEO_SEARCH_URL=https://sapamericaproductiontyfzmfz0.org.coveo.com/rest/search/v2?organizationId=sapamericaproductiontyfzmfz0
#SAP_COVEO_SEARCH_HUB=SAP for Me
#SAP_NOTE_URL=https://me.sap.com/notes/{id}
#SAP_NOTE_API_URL=https://me.sap.com/backend/raw/sapnotes/Detail?q={id}&t=E&isVTEnabled=false
#SAP_PROBE_URL=https://me.sap.com/notes/2170696
#SAP_STATE_PATH=/home/user/.sap-notes-mcp/session.json
#SAP_NAV_TIMEOUT_MS=60000
#SAP_API_TIMEOUT_MS=60000
#SAP_NETWORK_IDLE_TIMEOUT_MS=4000
#SAP_RENDER_SETTLE_MS=2500

# Zielordner fuer heruntergeladene Note-Anhaenge (eine Unterordner je Note-Nummer)
#SAP_ATTACHMENT_DIR=~/Downloads/sap-notes

# Browser nach Inaktivitaet schliessen und beim naechsten Aufruf neu starten (0 = aus)
#SAP_IDLE_TIMEOUT_MS=600000
