# --- Automatischer Login -------------------------------------------------
# Wird beim Start von src/server.ts und `npm run login` aus dieser Datei gelesen.
# Die Datei ist optional — dieselben Variablen koennen direkt aus der Prozessumgebung
# kommen (Shell-Export, env-Block der MCP-Client-Config, systemd, Container-Secrets);
# echte Umgebungsvariablen haben immer Vorrang. Datei danach: chmod 600 .env
#
# Mit beiden Werten meldet sich der Server nach Ablauf der Session selbst neu an;
# ohne Passwort bleibt es beim bisherigen Verhalten (Hinweis auf `npm run login`).
# ACHTUNG: Verlangt der SAP-Identity-Provider MFA, ist kein Auto-Login moeglich —
# dann einmalig `npm run login` und MFA im Browserfenster bestaetigen.
#SAPUSER=S0001234567
#SAPPASSWORD=

# Auto-Login komplett abschalten, auch wenn Credentials gesetzt sind
#SAP_AUTO_LOGIN=0
# Sperrzeit nach fehlgeschlagenem Auto-Login (verhindert Login-Sturm / User-Sperre)
#SAP_AUTO_LOGIN_COOLDOWN_MS=300000
# Timeout je Login-Schritt (Feld erscheint, Seite reagiert)
#SAP_LOGIN_STEP_TIMEOUT_MS=30000

# Alternativer Pfad zur .env-Datei. Exklusiv: ist die Variable gesetzt, wird NUR
# dieser Pfad gelesen (kein stiller Rueckfall auf eine andere .env).
#SAP_ENV_FILE=/etc/sap-notes-mcp/.env

# Selektoren des Logon-Formulars, falls SAP das Frontend umbaut
#SAP_LOGIN_USER_SELECTOR=input#j_username, input[name='j_username'], input[name='mail'], input[type='email']
#SAP_LOGIN_PASSWORD_SELECTOR=input#j_password, input[name='j_password'], input[type='password']
#SAP_LOGIN_SUBMIT_SELECTOR=#logOnFormSubmit, button[type='submit'], input[type='submit']
#SAP_LOGIN_MFA_SELECTOR=input[autocomplete='one-time-code'], input[name*='otp' i]

# --- Portal ---------------------------------------------------------------
# Optional: URLs anpassen, falls SAP das Portal umbaut
#SAP_SEARCH_URL=https://me.sap.com/search?q={query}&tab=notes
#SAP_COVEO_ORG=sapamericaproductiontyfzmfz0
#SAP_COVEO_TOKEN_URL=https://me.sap.com/backend/raw/coveo/CoveoToken
#SAP_COVEO_SEARCH_URL=https://sapamericaproductiontyfzmfz0.org.coveo.com/rest/search/v2?organizationId=sapamericaproductiontyfzmfz0
#SAP_COVEO_SEARCH_HUB=SAP for Me
#SAP_NOTE_URL=https://me.sap.com/notes/{id}
#SAP_NOTE_API_URL=https://me.sap.com/backend/raw/sapnotes/Detail?q={id}&t=E&isVTEnabled=false
#SAP_PROBE_URL=https://me.sap.com/notes/2170696
#SAP_STATE_PATH=/home/user/.sap-notes-mcp/session.json
#SAP_NAV_TIMEOUT_MS=60000
#SAP_API_TIMEOUT_MS=60000
#SAP_NETWORK_IDLE_TIMEOUT_MS=4000
#SAP_RENDER_SETTLE_MS=2500

# Zielordner fuer heruntergeladene Note-Anhaenge (eine Unterordner je Note-Nummer)
#SAP_ATTACHMENT_DIR=~/Downloads/sap-notes

# Browser nach Inaktivitaet schliessen und beim naechsten Aufruf neu starten (0 = aus)
#SAP_IDLE_TIMEOUT_MS=600000
