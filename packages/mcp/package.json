{
  "version": "1.15.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "name": "@sap-notes/mcp",
  "description": "SAP Notes MCP server and login CLI",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run build && node --test dist/*.test.js",
    "start": "node dist/server.js",
    "login": "npm run build && node dist/login.js",
    "test-search": "node dist/test-search.js",
    "diagnose-search": "node dist/diagnose-search.js",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8",
    "@sap-notes/core": "1.15.1"
  }
}
