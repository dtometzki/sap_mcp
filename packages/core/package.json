{
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "name": "@sap-notes/core",
  "description": "Shared SAP Notes access library",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
