{
  "version": "1.15.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "name": "@sap-notes/web",
  "description": "Local SAP Notes web application",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run build && node --test dist/*.test.js",
    "start": "node dist/main.js",
    "web": "npm run build && node dist/main.js",
    "web:start": "npm run build && node dist/daemon.js start",
    "web:stop": "node dist/daemon.js stop",
    "web:status": "node dist/daemon.js status",
    "web:restore-vault": "bash scripts/restore-web-vault.sh",
    "web:cloud-start": "bash scripts/cloud-web-start.sh",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "markdown-it": "^15.0.1",
    "zod": "^3.23.8",
    "@sap-notes/core": "1.15.1"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
