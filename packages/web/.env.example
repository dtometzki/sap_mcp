# SAP Notes Web: optionale Konfiguration, Zugangsdaten ausschließlich im Tresor.
# App-.env > Workspace-.env > Arbeitsverzeichnis; Prozessvariablen haben Vorrang.
# SAP_ENV_FILE ist exklusiv.
#SAP_ENV_FILE=/etc/sap-notes-web/.env

# Lokale Web-App (npm run web), ausschließlich http://127.0.0.1
# SAP_WEB_PORT=3210
# SAP_WEB_DATA_DIR=~/.sap-notes-web
# Tresor nach Inaktivität sperren und alle Browser-Sitzungen abmelden (0 = aus)
# SAP_WEB_IDLE_LOCK_MS=1800000
# SAP-Zugangsdaten für die Web-App werden ausschließlich im verschlüsselten Tresor verwaltet.
#
# Cursor Cloud: vorhandene vault.enc als vier Base64-Teile in Environment-Secrets
# hinterlegen (keine Werte hier eintragen). Fehlt ein Teil, bricht der Umgebungstart ab.
# SAP_WEB_VAULT_B64_1=
# SAP_WEB_VAULT_B64_2=
# SAP_WEB_VAULT_B64_3=
# SAP_WEB_VAULT_B64_4=

# Gemeinsame SAP-Portal- und Browser-Einstellungen
#SAP_AUTO_LOGIN_COOLDOWN_MS=300000
#SAP_LOGIN_STEP_TIMEOUT_MS=30000
#SAP_LOGIN_USER_SELECTOR=input#j_username, input[name='j_username'], input[name='mail'], input[type='email']
#SAP_LOGIN_PASSWORD_SELECTOR=input#j_password, input[name='j_password'], input[type='password']
#SAP_LOGIN_SUBMIT_SELECTOR=#logOnFormSubmit, button[type='submit'], input[type='submit']
#SAP_LOGIN_MFA_SELECTOR=input[autocomplete='one-time-code'], input[name*='otp' i]
#SAP_SEARCH_URL=https://me.sap.com/search?q={query}&tab=notes
#SAP_COVEO_ORG=sapamericaproductiontyfzmfz0
#SAP_COVEO_TOKEN_URL=https://me.sap.com/backend/raw/coveo/CoveoToken
#SAP_COVEO_SEARCH_URL=https://sapamericaproductiontyfzmfz0.org.coveo.com/rest/search/v2?organizationId=sapamericaproductiontyfzmfz0
#SAP_COVEO_SEARCH_HUB=SAP for Me
#SAP_NOTE_URL=https://me.sap.com/notes/{id}
#SAP_NOTE_API_URL=https://me.sap.com/backend/raw/sapnotes/Detail?q={id}&t=E&isVTEnabled=false
#SAP_PROBE_URL=https://me.sap.com/notes/2170696
#SAP_NAV_TIMEOUT_MS=60000
#SAP_API_TIMEOUT_MS=60000
#SAP_NETWORK_IDLE_TIMEOUT_MS=0
#SAP_RENDER_SETTLE_MS=2500
#SAP_ATTACHMENT_COOKIE_HOSTS=softwaredownloads.sap.com
#SAP_IDLE_TIMEOUT_MS=600000
